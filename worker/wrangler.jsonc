{
   "$schema": "node_modules/wrangler/config-schema.json",
   "name": "mirokit-site",
   "main": "src/index.js",
   "compatibility_date": "2026-08-29",
   "workers_dev": false,
   "assets": {
      "directory": "../site",
      "not_found_handling": "404-page",
      "binding": "ASSETS",
      "run_worker_first": [
         "/api/*",
         "/admin/*",
         "/media/v1/*",
         "/",
         "/index.html",
         "/page/*",
         "/robots.txt",
         "/sitemap.xml",
         "/public/assets/archive/*",
         "/public/assets/uploads/*",
         "/public/assets/media/interviews/transcripts/*",
         "/public/assets/media/press/*"
      ]
   },
   "d1_databases": [
      {
         "binding": "SITE_DB",
         "database_name": "mirokit-database",
         "database_id": "0c8ba56d-a0d7-4955-a605-354c5139a146"
      }
   ],
   "r2_buckets": [
      {
         "binding": "SITE_MEDIA",
         "bucket_name": "mirokit-media"
      }
   ],
   "ratelimits": [
      {
         "name": "CONTACT_FORM_RATE_LIMITER",
         "namespace_id": "1001",
         "simple": {
            "limit": 5,
            "period": 60
         }
      }
   ],
   "routes": [
      {
         "pattern": "mirokit.com",
         "custom_domain": true
      },
      {
         "pattern": "mirokit.ru",
         "custom_domain": true
      },
      {
         "pattern": "ligamirokit.com",
         "custom_domain": true
      },
      {
         "pattern": "ligamirokit.ru",
         "custom_domain": true
      }
   ],
   "send_email": [
      {
         "name": "CONTACT_EMAIL",
         "destination_address": "mirokit2025@gmail.com",
         "allowed_sender_addresses": [
            "info@mirokit.com",
            "info@mirokit.ru"
         ]
      }
   ],
   "vars": {
      "MAIL_TO": "mirokit2025@gmail.com",
      "ALLOWED_ORIGINS": "https://mirokit.com,https://mirokit.ru,https://ligamirokit.com,https://ligamirokit.ru",
      "TURNSTILE_HOSTNAMES": "mirokit.com,mirokit.ru,ligamirokit.com,ligamirokit.ru"
   },
   "secrets": {
      "required": [
         "TURNSTILE_SECRET"
      ]
   }
}
